# Supabase — from your project's API settings (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, bypasses RLS.
# Used by the Stripe webhook and checkout flow to write billing columns.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — server-only, never expose with NEXT_PUBLIC_
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Stripe billing — all server-only except the app URL.
# Secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Signing secret of your webhook endpoint (/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Price ID of the recurring Pro subscription product
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
# Public base URL used for Stripe redirect URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
